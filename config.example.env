# Un-remarkable build and publishing settings. Copy to config.local.env (never committed) and fill in
# only what you use. Everything is optional: with nothing set you get a working app with in-app
# updates switched off, and you install it with scripts/build-app.sh.

# Where your builds are published (the folder that holds mac-version.json and Un-remarkable-mac.zip).
# Built into the app as its update feed, and into install-mac.sh as its download address.
# DOWNLOAD_URL="https://example.com/unremarkable"

# Your companion web app (github.com/adamtdm/Un-remarkable), if you run one: the default address for
# Settings › Search › Companion server.
# COMPANION_URL="http://my-server:8099"

# Where scripts/publish.sh uploads them over SSH: host and folder (relative to the SSH home).
# PAGES_HOST="user@my-server"
# PAGES_DIR="pages/unremarkable"
# scripts/release-public.sh: publish each version to a separate public GitHub repository as one commit
# (keeps your private history private), and who the commit is from.
# PUBLIC_REPO="owner/name"
# PUBLIC_AUTHOR="yourhandle <yourhandle@users.noreply.github.com>"

# Optional extra pages whose <!--mac-meta--> version line should also be updated (space-separated).
# PAGES_EXTRA_INDEX="pages/index.html"
